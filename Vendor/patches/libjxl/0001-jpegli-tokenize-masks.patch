+// holdmybyte patch (Vendor/patches/libjxl/0001-jpegli-tokenize-masks.patch): the progressive AC tokenisers below
+// visit only the coefficients that matter, found through two 64-bit masks per block, instead of testing all
+// Se - Ss + 1 coefficients one by one. The tokens, refinement bits and counters they produce are exactly those of
+// the upstream loops (same order, same values); only the zero coefficients are skipped in bulk.
+//   nz:  bit k set iff Ss <= k <= Se and (|block[k]| >> Al) != 0
+//   any: bit k set iff Ss <= k <= Se and block[k] != 0
+inline void CoefficientMasks(const coeff_t* block, int Ss, int Se, int Al,
+                             uint64_t* nz, uint64_t* any) {
+  uint64_t n = 0;
+  uint64_t a = 0;
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+  static const uint8_t kWeights[8] = {1, 2, 4, 8, 16, 32, 64, 128};
+  const uint8x8_t weights = vld1_u8(kWeights);
+  const uint16x8_t threshold = vdupq_n_u16(static_cast<uint16_t>(1u << Al));
+  for (int i = 0; i < 8; ++i) {
+    const int16x8_t v = vld1q_s16(block + 8 * i);
+    const uint16x8_t magnitude = vreinterpretq_u16_s16(vabsq_s16(v));
+    const uint8x8_t ge = vmovn_u16(vcgeq_u16(magnitude, threshold));
+    const uint8x8_t ne = vmovn_u16(vtstq_s16(v, v));
+    n |= static_cast<uint64_t>(vaddv_u8(vand_u8(ge, weights))) << (8 * i);
+    a |= static_cast<uint64_t>(vaddv_u8(vand_u8(ne, weights))) << (8 * i);
+  }
+#else
+  for (int k = 0; k < DCTSIZE2; ++k) {
+    int c = block[k];
+    int magnitude = c < 0 ? -c : c;
+    if ((magnitude >> Al) != 0) n |= uint64_t{1} << k;
+    if (c != 0) a |= uint64_t{1} << k;
+  }
+#endif
+  const uint64_t range = (~uint64_t{0} >> (63 - Se)) & (~uint64_t{0} << Ss);
+  *nz = n & range;
+  *any = a & range;
+}
